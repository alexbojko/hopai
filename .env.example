# cp .env.example .env, then fill in the provider you use.
# Every variable here is optional: without an embedding provider the
# stack still runs and serves everything except search-by-text.

# --- the database ----------------------------------------------------
POSTGRES_PASSWORD=testpass
POSTGRES_DB=hopai
POSTGRES_PORT=5432

# --- published ports (bound to 127.0.0.1) ----------------------------
HOPAI_API_PORT=8080
HOPAI_MCP_PORT=8000

# --- the vector field both services declare --------------------------
# `--vector TARGET:NAME:DIMENSIONS`. The dimensions MUST match the model
# below: 1536 for text-embedding-3-small, 3072 for -3-large, 1024 for
# embed-v4.0 and voyage-3, 768 for text-embedding-004.
HOPAI_VECTOR_TARGET=nodes
HOPAI_VECTOR_FIELD=summary
HOPAI_VECTOR_DIMENSIONS=1536

# --- embeddings ------------------------------------------------------
# One of: openai, azure-openai, cohere, voyage, google,
# sentence-transformers. Leave empty for no search-by-text.
# `docker compose run --rm api hopai-mcp --embed-provider-help` prints
# which variables each one reads.
HOPAI_EMBED_PROVIDER=
# The model, or on Azure the DEPLOYMENT name. Never guessed: the model
# answering a query has to be the model that wrote the stored vectors.
HOPAI_EMBED_MODEL=

# OpenAI
OPENAI_API_KEY=
# Also how an OpenAI-COMPATIBLE endpoint is reached (vLLM, a gateway).
OPENAI_BASE_URL=

# Azure OpenAI. The DEPLOYMENT name is what you created in the portal
# and is often NOT the same string as the model it serves -- passing the
# model name here is the usual way this configuration fails.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Cohere / Voyage / Google
COHERE_API_KEY=
VOYAGE_API_KEY=
GOOGLE_API_KEY=

# --- image build -----------------------------------------------------
# Extras baked into the image. Add a provider here if you use one that
# is not OpenAI or Azure; a rebuild is needed after changing it.
HOPAI_EXTRAS=http,mcp,openai
